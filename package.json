  "scripts": {
    "start": "ANTHROPIC_API_KEY=$(node -e \"const fs=require('fs'); const c=JSON.parse(fs.readFileSync(process.env.HOME+'/.openclaw/agents/main/agent/auth-profiles.json')); console.log(c.profiles['anthropic:default'].key)\") node server.js",
